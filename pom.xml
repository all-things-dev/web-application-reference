<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- Spring Boot parent configuration for centralized dependency management -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.2.0-M1</version>

		<relativePath />
	</parent>

	<groupId>dev.all-things.reference</groupId>
	<artifactId>web-application-reference</artifactId>
	<version>2.0.0-SNAPSHOT</version>

	<!-- This module will be packaged as POM -->
	<packaging>pom</packaging>

	<name>Web Application Reference</name>
	<description>Reference for creating web applications in Java</description>

	<!-- Project details -->
	<url>https://github.com/all-things-dev/web-application-reference</url>

	<scm>
		<url>https://github.com/all-things-dev/web-application-reference</url>
	</scm>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
		</license>
	</licenses>

	<organization>
		<name>All Things Dev</name>
		<url>https://github.com/all-things-dev</url>
	</organization>

	<!-- Project modules -->
	<modules>
		<module>web-api</module>
	</modules>

	<!-- Project properties -->
	<properties>

		<!-- Logging -->
		<log4j.version>2.26.1</log4j.version>
		<lmax.version>4.0.0</lmax.version>
		<!-- <slf4j.version>2.1.0-alpha1</slf4j.version> -->

		<!-- Apache Commons -->
		<apache.commons-lang.version>3.20.0</apache.commons-lang.version>

		<!-- Frameworks -->
		<spring.framework.version>7.1.0-M1</spring.framework.version>
		<spring.security.version>7.2.0-M1</spring.security.version>

		<!-- Byte code generation -->
		<byte-buddy.version>1.18.11</byte-buddy.version>

		<!-- Serialization -->
		<jackson.version>3.2.1</jackson.version>
		<jackson2.version>2.22.1</jackson2.version>

		<!-- Database -->
		<postgresql.jdbc.version>42.7.13</postgresql.jdbc.version>
		<hikaricp.version>7.1.0</hikaricp.version>
		<flyway.version>13.1.0</flyway.version>

		<!-- Persistence -->
		<hibernate.version>7.4.5.Final</hibernate.version>

		<!-- Job scheduling -->
		<quartz.version>2.5.2</quartz.version>

		<!-- Caching -->
		<hazelcast.version>5.7.0</hazelcast.version>
		<all-things-dev.hazelcast-starter.version>2.0.0</all-things-dev.hazelcast-starter.version>

		<!-- Testing -->
		<junit.jupiter.version>6.1.3</junit.jupiter.version>
		<!-- Fallback placeholder needed for Surefire plugin configuration on JDK 21 and above -->
		<argLine />

		<!-- Application servers -->
		<tomcat.version>11.0.24</tomcat.version>

		<!-- Plugins -->
		<maven.compiler-plugin.version>3.15.0</maven.compiler-plugin.version>
		<maven.surefire-plugin.version>3.5.6</maven.surefire-plugin.version>
		<maven.failsafe-plugin.version>3.5.6</maven.failsafe-plugin.version>
		<maven.resources-plugin.version>3.5.0</maven.resources-plugin.version>
		<maven.reports-plugin.version>3.9.0</maven.reports-plugin.version>
		<maven.war-plugin.version>3.5.1</maven.war-plugin.version>

		<!-- Spring Boot overrides -->
		<log4j2.version>${log4j.version}</log4j2.version>
		<commons-lang3.version>${apache.commons-lang.version}</commons-lang3.version>
		<spring-framework.version>${spring.framework.version}</spring-framework.version>
		<spring-security.version>${spring.security.version}</spring-security.version>
		<jackson-bom.version>${jackson.version}</jackson-bom.version>
		<jackson-2-bom.version>${jackson2.version}</jackson-2-bom.version>
		<postgresql.version>${postgresql.jdbc.version}</postgresql.version>
		<junit-jupiter.version>${junit.jupiter.version}</junit-jupiter.version>

		<!-- Spring Boot plugin overrides -->
		<maven-compiler-plugin.version>${maven.compiler-plugin.version}</maven-compiler-plugin.version>
		<maven-surefire-plugin.version>${maven.surefire-plugin.version}</maven-surefire-plugin.version>
		<maven-failsafe-plugin.version>${maven.failsafe-plugin.version}</maven-failsafe-plugin.version>
		<maven-resources-plugin.version>${maven.resources-plugin.version}</maven-resources-plugin.version>
		<maven-war-plugin.version>${maven.war-plugin.version}</maven-war-plugin.version>

		<!-- Compiler configuration -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<java.version>26</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>

	</properties>

	<!-- Build and plugin configuration -->
	<build>

		<!-- Common convention for generated artifacts -->
		<finalName>${project.artifactId}-${project.version}</finalName>

		<!-- Managed plugin configuration -->
		<pluginManagement>
			<plugins>

				<!-- Maven reports plugin configuration for site generation -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-project-info-reports-plugin</artifactId>
					<version>${maven.reports-plugin.version}</version>
				</plugin>

				<!-- Maven dependency and surefire plugin configuration for JDK 21 and above  -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-dependency-plugin</artifactId>
					<executions>
						<execution>
							<goals>
								<goal>properties</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
					</configuration>
				</plugin>

			</plugins>
		</pluginManagement>
	</build>

	<!-- Managed dependency configuration -->
	<dependencyManagement>
		<dependencies>

			<!-- Logging -->

			<dependency>
				<groupId>com.lmax</groupId>
				<artifactId>disruptor</artifactId>
				<version>${lmax.version}</version>
			</dependency>

			<!-- Spring framework -->

			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter</artifactId>

				<exclusions>

					<!-- Disabling default 'logback' logging in favor of Log4j2 -->
					<exclusion>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-starter-logging</artifactId>
					</exclusion>

					<!-- Disabling (unused) SnakeYAML dependency -->
					<exclusion>
						<groupId>org.yaml</groupId>
						<artifactId>snakeyaml</artifactId>
					</exclusion>

				</exclusions>
			</dependency>

			<!-- Caching -->

			<dependency>
				<groupId>dev.all-things.boot</groupId>
				<artifactId>hazelcast-spring-boot-starter</artifactId>
				<version>${all-things-dev.hazelcast-starter.version}</version>
			</dependency>

		</dependencies>
	</dependencyManagement>
</project>